rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to get current user document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Helper to check admin role (supports Auth Custom Claims 'role: admin', 'admin: true', Firestore user doc, and root emails)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        getUserData().role == 'admin' ||
        request.auth.token.email == 'ianzinhopaterraoficial@gmail.com' ||
        request.auth.token.email == 'vmpveiculos@gmail.com' ||
        request.auth.token.email == 'marcospaterra31@gmail.com' ||
        request.auth.token.email == 'admin@mundoazul.com.br' ||
        request.auth.token.email == 'Marcospaterra@ianpaterra' ||
        request.auth.token.email == 'marcospaterra@ianpaterra' ||
        request.auth.token.email == 'Marcospaterra@ianpaterra.com' ||
        request.auth.token.email == 'marcospaterra@ianpaterra.com' ||
        request.auth.token.email.matches('(?i).*marcospaterra.*')
      );
    }

    function isParent() {
      return isAuthenticated() && (
        request.auth.token.role == 'parent' ||
        getUserData().role == 'parent' || 
        isAdmin()
      );
    }

    function isTherapist() {
      return isAuthenticated() && (
        request.auth.token.role == 'therapist' ||
        getUserData().role == 'therapist' || 
        isAdmin()
      );
    }

    function isSchool() {
      return isAuthenticated() && (
        request.auth.token.role == 'school' ||
        getUserData().role == 'school' || 
        isAdmin()
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Children Collection (Prontuário do Ian)
    match /children/{childId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
      
      // Sub-links
      match /professionals/{profId} {
        allow read, write: if isAuthenticated();
      }
      match /parents/{parentId} {
        allow read, write: if isAuthenticated();
      }
      match /schools/{schoolId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Sessions & Atendimentos Terapêuticos
    match /sessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }

    // Agenda Events
    match /agenda/{agendaId} {
      allow read, write: if isAuthenticated();
    }

    // Goals & Metas PEI
    match /goals/{goalId} {
      allow read, write: if isAuthenticated();
    }

    // Achievements & Conquistas
    match /achievements/{achId} {
      allow read, write: if isAuthenticated();
    }

    // School Records & Observações Escolares
    match /school_records/{recId} {
      allow read, write: if isAuthenticated();
    }

    // Diary & Mood Records (Observações da Família e Terapeutas)
    match /diary/{diaryId} {
      allow read, write: if isAuthenticated();
    }

    // Documents
    match /documents/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Moments & Galeria de Registros Visuais
    match /moments/{momentId} {
      allow read, write: if isAuthenticated();
    }

    // Messages / Chat
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.senderId);
    }

    // Direct Channels (Terapeutas / Escola ↔ Pais)
    match /direct_channels/{channelId} {
      allow read, write: if isAuthenticated();
    }

    // Direct Messages (Mensagens Instantâneas Individuais)
    match /direct_messages/{msgId} {
      allow read, write: if isAuthenticated();
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.senderId);
    }

    // Admin Logs
    match /logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAuthenticated();
    }
  }
}
