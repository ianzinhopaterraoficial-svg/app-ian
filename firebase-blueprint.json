  "firestore": {
    "/children/{childId}": {
      "schema": "Child",
      "description": "Coleção do prontuário da criança"
    },
    "/sessions/{sessionId}": {
      "schema": "TherapySession",
      "description": "Atendimentos e sessões terapêuticas"
    },
    "/goals/{goalId}": {
      "schema": "Goal",
      "description": "Metas e PEI"
    },
    "/achievements/{achId}": {
      "schema": "Achievement",
      "description": "Conquistas e marcos"
    },
    "/diary/{diaryId}": {
      "schema": "DiaryRecord",
      "description": "Diário de rotina e humor"
    },
    "/school_records/{recId}": {
      "schema": "SchoolRecord",
      "description": "Anotações e recados escolares"
    },
    "/agenda/{agendaId}": {
      "schema": "AgendaEvent",
      "description": "Agenda de compromissos"
    },
    "/observations/{obsId}": {
      "schema": "ObservationRecord",
      "description": "Observações multidisciplinares"
    },
    "/documents/{docId}": {
      "schema": "DocumentRecord",
